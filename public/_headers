# Cabeçalhos dos assets estáticos (Workers Static Assets: servidos antes do worker/index.ts, por
# isso o Cache-Control vem daqui). Só ficheiros com o hash do conteúdo no nome levam cache longa.
# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Modelos 3D (scripts/fetch-food-models.ts põe o hash no nome)
/models/*.glb
  Cache-Control: public, max-age=31536000, immutable
