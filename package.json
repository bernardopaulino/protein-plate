{
  "name": "protein-plate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "content:check": "tsx scripts/content-check.ts",
    "content:build": "tsx scripts/content-build.ts",
    "db:seed:local": "npm run content:build && wrangler d1 execute DB --local --file=.seed/foods.sql",
    "eval:recipes": "tsx --env-file-if-exists=.dev.vars scripts/eval-recipes.ts",
    "library:generate": "tsx --env-file-if-exists=.dev.vars scripts/library-generate.ts",
    "library:load:local": "wrangler d1 execute DB --local --file=.library/recipes.sql",
    "library:load:staging": "wrangler d1 execute DB --remote --env staging --file=.library/recipes.sql",
    "library:load:production": "wrangler d1 execute DB --remote --env production --file=.library/recipes.sql",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --env-file .dev.vars.example",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "admin:dev": "wrangler dev -c admin/wrangler.jsonc --persist-to .wrangler/state --port 8789",
    "admin:test": "vitest run --config admin/vitest.config.ts",
    "admin:typecheck": "tsc --noEmit -p admin/tsconfig.json",
    "admin:types": "wrangler types -c admin/wrangler.jsonc admin/cloudflare-env.d.ts --strict-vars=false",
    "admin:deploy:staging": "wrangler deploy -c admin/wrangler.jsonc --env staging",
    "admin:deploy:production": "wrangler deploy -c admin/wrangler.jsonc --env production",
    "test:lighthouse": "lhci autorun",
    "og:images": "node scripts/og-images.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.138",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@react-three/fiber": "9.8.2",
    "ai": "6.0.323",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@gltf-transform/cli": "4.5.1",
    "@lhci/cli": "0.16.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "glob@>=10.2.0 <10.5.0": "10.5.0",
    "tmp": "0.2.6"
  }
}
